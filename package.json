{
  "name": "haedeuk-hospital-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma migrate deploy && tsx prisma/syncAdmin.ts && next build",
    "build:app": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "yarn lint:eslint && yarn lint:stylelint",
    "lint:eslint": "eslint src --max-warnings=0",
    "lint:stylelint": "stylelint \"src/**/*.scss\" --config .stylelintrc.json",
    "lint:fix": "eslint src --fix --max-warnings=0 && stylelint \"src/**/*.scss\" --fix --config .stylelintrc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:sync-admin": "tsx prisma/syncAdmin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.117.0",
    "next": "^16.4.0",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-kakao-maps-sdk": "^1.1.0",
    "sass": "^1.104.0",
    "server-only": "0.0.1",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@next/eslint-plugin-next": "^16.4.0",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.3.0",
    "eslint-plugin-import-x": "^4.15.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^14.0.0",
    "postcss": "^8.4.0",
    "postcss-scss": "^4.0.0",
    "prisma": "^7.9.0",
    "stylelint": "^17.10.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "stylelint-selector-bem-pattern": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
