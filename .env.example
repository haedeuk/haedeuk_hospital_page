# .env.local 로 복사해서 값을 채운다. (.env.local 은 커밋되지 않는다)
# Vercel 에는 같은 이름으로 Project → Settings → Environment Variables 에 넣는다.

# ── Supabase (로그인·사진) ───────────────────────────────────────
# Project Settings → Data API → Project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── 데이터베이스 (Prisma) ────────────────────────────────────────
# 대시보드 상단 Connect → Connection String → ORMs 탭 → Prisma 에 두 줄이 나온다.
# [YOUR-PASSWORD] 를 DB 비밀번호로 바꾼다. 채팅·코드에 붙여 넣지 않는다.
# 앱 실행용: Transaction pooler (포트 6543)
DATABASE_URL=
# 마이그레이션용: Session pooler (포트 5432)
DIRECT_URL=

# ── 관리자 ───────────────────────────────────────────────────────
# Authentication → Users → Add user 로 만든 관리자 계정의 이메일.
# 로그인 화면에서는 아이디 admin 으로 들어온다. 비밀번호는 Supabase 만 안다.
ADMIN_EMAIL=

# ── 사이트 ───────────────────────────────────────────────────────
# canonical · OG · sitemap 의 절대 주소 기준
NEXT_PUBLIC_SITE_URL=https://haedeuk-geumcheon.com
# 카카오 디벨로퍼스 JavaScript 키 (플랫폼 → Web 에 배포 도메인 등록)
NEXT_PUBLIC_KAKAO_MAP_KEY=
